# 仿真产物
sim/work/
*.vcd
*.wdb
xsim.dir/
# Python
__pycache__/
*.pyc
# Vivado 工程产物（目录级：整个工程/日志/中间文件都不入库）
fpga/vivado_*/
fpga/scripts/*.log
fpga/scripts/vivado*
fpga/scripts/program.hex
*.bit
*.ltx
*.rpt
*.jou
# riscv-tests generated outputs
testprog/rvtest/
# riscv-tests upstream root files (only isa/ + LICENSE tracked)
# riscv-tests: track only rv32ui/rv64ui/macros + LICENSE
riscv-tests-src/
!riscv-tests-src/riscv-tests-master/
riscv-tests-src/riscv-tests-master/*
!riscv-tests-src/riscv-tests-master/isa/
!riscv-tests-src/riscv-tests-master/LICENSE
riscv-tests-src/riscv-tests-master/isa/*
!riscv-tests-src/riscv-tests-master/isa/rv32ui/
!riscv-tests-src/riscv-tests-master/isa/rv64ui/
!riscv-tests-src/riscv-tests-master/isa/macros/
# 下载缓存与工具链包（大文件不入库）
bench/*.zip
bench/toolchain/*.zip
bench/coremark/coremark-main/docs/
